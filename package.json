{
  "name": "token-efficient-ids",
  "version": "1.0.0",
  "description": "Generate token-efficient IDs for LLMs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./non-secure": {
      "types": "./dist/non-secure.d.ts",
      "import": "./dist/non-secure.js",
      "require": "./dist/non-secure.cjs"
    },
    "./dictionaries": {
      "types": "./dist/dictionaries.d.ts",
      "import": "./dist/dictionaries.js",
      "require": "./dist/dictionaries.cjs"
    }
  },
  "files": [
    "dist",
    "tokenizers"
  ],
  "scripts": {
    "build": "pnpm build:dictionaries && tsup",
    "build:dictionaries": "tsx scripts/build-dictionaries.ts",
    "dev": "tsup --watch",
    "download": "bash scripts/download-tokenizers.sh",
    "benchmark": "tsx benchmark.ts",
    "efficiency": "tsx --env-file=.env scripts/efficiency.ts",
    "compare": "tsx --env-file=.env scripts/compare.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "tokens",
    "llm",
    "tokenizer",
    "ids"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@types/node": "^25.0.6",
    "nanoid": "^5.1.6",
    "tinybench": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
